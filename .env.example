# Bot token from the Discord Developer Portal (Bot tab > Reset Token). Keep this secret.
DISCORD_TOKEN=paste-your-token-here

# Your server's ID. Right-click the server icon > Copy Server ID (needs Developer Mode on).
# Leave blank to register commands everywhere, but then they can take up to an hour to show.
GUILD_ID=

# Optional: where to save ticks. Defaults to data.json next to index.js.
# DATA_FILE=/data/data.json
